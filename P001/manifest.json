{
  "manifest_version": 3,
  "name": "Cross-Origin Fetch Helper",
  "version": "1.0",
  "description": "帮助前端通过postMessage进行跨域fetch请求",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}